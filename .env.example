# Postgres connection string from your Supabase project (Settings -> Database)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase project URL and anon/public key (Settings -> API) — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"

# Supabase service role key (Settings -> API) — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Base URL of this app — used to build the redirect link in invite emails.
# Update to your real domain once deployed.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Resend API key (resend.com) for sending approval/rejection emails.
# Optional — leave blank to skip real email sending during development;
# the invite link will show directly in the admin UI instead.
RESEND_API_KEY=""
